{
  "version": 6,
  "configurePresets": [
    {
      "name": "arm64-linux-dynamic-dbg",
      "binaryDir": "build/arm64-linux-dynamic/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
      }
    },
    {
      "name": "arm64-linux-dynamic-rel",
      "binaryDir": "build/arm64-linux-dynamic/release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
      }
    },
    {
      "name": "x64-linux-dynamic-dbg",
      "binaryDir": "build/x64-linux-dynamic/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "x64-linux-dynamic-rel",
      "binaryDir": "build/x64-linux-dynamic/release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "arm64-linux-dynamic-dbg",
      "configurePreset": "arm64-linux-dynamic-dbg",
      "jobs": 2
    },
    {
      "name": "arm64-linux-dynamic-rel",
      "configurePreset": "arm64-linux-dynamic-rel",
      "jobs": 2
    },
    {
      "name": "x64-linux-dynamic-dbg",
      "configurePreset": "x64-linux-dynamic-dbg",
      "jobs": 2
    },
    {
      "name": "x64-linux-dynamic-rel",
      "configurePreset": "x64-linux-dynamic-rel",
      "jobs": 2
    }
  ],

  "workflowPresets": [
    {
      "name": "ci-arm64-linux-dynamic-dbg",
      "steps": [
        { "type": "configure", "name": "arm64-linux-dynamic-dbg" },
        { "type": "build", "name": "arm64-linux-dynamic-dbg" }
      ]
    },
    {
      "name": "ci-arm64-linux-dynamic-rel",
      "steps": [
        { "type": "configure", "name": "arm64-linux-dynamic-rel" },
        { "type": "build", "name": "arm64-linux-dynamic-rel" }
      ]
    },
    {
      "name": "ci-x64-linux-dynamic-dbg",
      "steps": [
        { "type": "configure", "name": "x64-linux-dynamic-dbg" },
        { "type": "build", "name": "x64-linux-dynamic-dbg" }
      ]
    },
    {
      "name": "ci-x64-linux-dynamic-rel",
      "steps": [
        { "type": "configure", "name": "x64-linux-dynamic-rel" },
        { "type": "build", "name": "x64-linux-dynamic-rel" }
      ]
    }
  ]
}