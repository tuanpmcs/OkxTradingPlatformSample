{
  "name": "okx-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend launcher for the desktop app",
  "scripts": {
    "start:desktop": "npm --prefix electron start",
    "install:desktop": "npm --prefix electron install",
    "pack:desktop": "npm --prefix electron run pack",
    "dist:desktop": "npm --prefix electron run dist",
    "dist:desktop:mac": "npm --prefix electron run dist:mac",
    "dist:desktop:win": "npm --prefix electron run dist:win"
  }
}
