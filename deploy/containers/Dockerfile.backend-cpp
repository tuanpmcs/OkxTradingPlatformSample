FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV VCPKG_ROOT=/root/vcpkg
WORKDIR /app

ARG TARGETARCH

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    build-essential \
    cmake \
    ninja-build \
    zip \
    unzip \
    pkg-config \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install vcpkg expected by CMake presets
RUN git clone --depth=1 https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT} \
    && ${VCPKG_ROOT}/bootstrap-vcpkg.sh -disableMetrics

# Copy only dependency manifests first so normal source edits keep this layer cached.
COPY vcpkg.json vcpkg-configuration.json ./
COPY vcpkg-triplets ./vcpkg-triplets

RUN case "${TARGETARCH}" in \
        arm64) VCPKG_TARGET_TRIPLET="arm64-linux-release" ;; \
        amd64) VCPKG_TARGET_TRIPLET="x64-linux-release" ;; \
        x64) VCPKG_TARGET_TRIPLET="x64-linux-release" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && ${VCPKG_ROOT}/vcpkg install \
        --overlay-triplets=/app/vcpkg-triplets \
        --triplet "${VCPKG_TARGET_TRIPLET}"

# Copy the project only after dependency installation so app-only changes rebuild faster.
COPY CMakeLists.txt CMakePresets.json main.cpp ./
COPY proto ./proto

# Build
RUN case "${TARGETARCH}" in \
        arm64) \
            CMAKE_WORKFLOW_PRESET="workflow-arm64-linux-release"; \
            CMAKE_BINARY_DIR="/app/build/docker/arm64-release" ;; \
        amd64) \
            CMAKE_WORKFLOW_PRESET="workflow-x64-linux-release"; \
            CMAKE_BINARY_DIR="/app/build/docker/x64-release" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && cmake --workflow --preset "${CMAKE_WORKFLOW_PRESET}" \
    && cp "${CMAKE_BINARY_DIR}/bin/hello_world" /usr/local/bin/hello_world

EXPOSE 50051
CMD ["/usr/local/bin/hello_world", "--grpc-port", "50051"]
