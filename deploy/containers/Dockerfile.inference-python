# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG ALL_PROXY=""
ARG NO_PROXY="backend-cpp,inference-python,localhost,127.0.0.1,pypi.org,files.pythonhosted.org,deb.debian.org"
ARG http_proxy=""
ARG https_proxy=""
ARG all_proxy=""
ARG no_proxy="backend-cpp,inference-python,localhost,127.0.0.1,pypi.org,files.pythonhosted.org,deb.debian.org"

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV HTTP_PROXY="" \
    HTTPS_PROXY="" \
    ALL_PROXY="" \
    NO_PROXY="backend-cpp,inference-python,localhost,127.0.0.1,pypi.org,files.pythonhosted.org,deb.debian.org" \
    http_proxy="" \
    https_proxy="" \
    all_proxy="" \
    no_proxy="backend-cpp,inference-python,localhost,127.0.0.1,pypi.org,files.pythonhosted.org,deb.debian.org"
WORKDIR /app
ARG TARGETARCH
ARG INSTALL_PROFILE=inference

RUN unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy \
    && rm -f /etc/apt/apt.conf.d/*proxy* /etc/apt/apt.conf.d/99proxy /etc/apt/apt.conf.d/proxy.conf \
    && apt-get -o Acquire::http::Proxy=false -o Acquire::https::Proxy=false update \
    && apt-get -o Acquire::http::Proxy=false -o Acquire::https::Proxy=false install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY ml_pipeline/requirements.txt ./requirements.txt
COPY ml_pipeline/requirements.inference.txt ./requirements.inference.txt
COPY ml_pipeline/requirements.training.txt ./requirements.training.txt
RUN --mount=type=cache,id=pip-${TARGETARCH}-${INSTALL_PROFILE},target=/root/.cache/pip \
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy \
    && pip config unset global.proxy 2>/dev/null || true \
    && \
    case "${INSTALL_PROFILE}" in \
      inference) REQ_FILE="requirements.inference.txt" ;; \
      training) REQ_FILE="requirements.training.txt" ;; \
      full) REQ_FILE="requirements.txt" ;; \
      *) echo "Unsupported INSTALL_PROFILE=${INSTALL_PROFILE}. Use: inference|training|full" && exit 1 ;; \
    esac \
    && pip install -r "${REQ_FILE}"

COPY ml_pipeline ./ml_pipeline
COPY backend/proto ./backend/proto
COPY models ./models

# Default model path can be overridden per deployment.
# Prefer a lighter tree model artifact for container memory safety.
ENV MODEL_PATH=/app/models/pulse_xgboost_v1.joblib
ENV MODEL_DIR_PATH=/app/models
ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1

EXPOSE 50061
CMD ["sh", "-c", "python -m ml_pipeline.serving.app --model ${MODEL_PATH} --model-dir ${MODEL_DIR_PATH} --host 0.0.0.0 --port 50061"]
