FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY ml_pipeline/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY ml_pipeline ./ml_pipeline
COPY proto ./proto

# Default model path can be overridden per deployment.
ENV MODEL_PATH=/app/models/pulse_lstm_v1.pt

EXPOSE 50061
CMD ["sh", "-c", "python ml_pipeline/prediction_server.py --model ${MODEL_PATH} --host 0.0.0.0 --port 50061"]
